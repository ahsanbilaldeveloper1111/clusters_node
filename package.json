{
  "name": "enterprise-advanced-app",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Node.js + TypeScript app with cluster, workers, PostgreSQL, and Docker",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "k8s:build": "bash scripts/k8s-build-images.sh",
    "k8s:deploy": "bash scripts/k8s-deploy-local.sh",
    "k8s:manifests": "kubectl kustomize k8s/overlays/local",
    "k8s:aws:prepare": "bash scripts/k8s-aws-prepare.sh",
    "k8s:aws:deploy": "bash scripts/k8s-aws-deploy.sh",
    "k8s:aws:manifests": "kubectl kustomize k8s/overlays/aws-production",
    "k8s:aws:sync-secrets": "bash scripts/k8s-aws-sync-secrets.sh",
    "k8s:delete": "kubectl delete -k k8s/overlays/local --ignore-not-found",
    "k8s:fix": "bash scripts/k8s-fix-redeploy.sh",
    "argocd:install": "bash scripts/argocd-install.sh",
    "argocd:bootstrap": "bash scripts/argocd-bootstrap.sh",
    "argocd:bootstrap:aws": "bash scripts/argocd-bootstrap-aws.sh",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
