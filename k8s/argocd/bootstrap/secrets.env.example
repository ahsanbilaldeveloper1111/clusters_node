# Copy to secrets.env and apply once before first Argo CD sync:
#   kubectl create secret generic app-secrets \
#     --from-env-file=k8s/overlays/production/secrets.env \
#     -n enterprise-app --dry-run=client -o yaml | kubectl apply -f -
#
# Or run: bash scripts/argocd-bootstrap-secrets.sh

JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://app_user:REPLACE@postgres-service:5432/enterprise_db
