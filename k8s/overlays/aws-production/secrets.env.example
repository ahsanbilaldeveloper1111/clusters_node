# Copy to secrets.env — populate from Terraform Secrets Manager after: terraform apply
#   bash scripts/k8s-aws-sync-secrets.sh
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
DATABASE_URL=postgresql://app_user:REPLACE@REPLACE.rds.amazonaws.com:5432/enterprise_db?sslmode=require
REDIS_URL=rediss://:REPLACE@REPLACE.cache.amazonaws.com:6379
