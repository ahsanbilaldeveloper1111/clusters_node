# Application
NODE_ENV=development
PORT=3000
CLUSTER_WORKERS=auto
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://app_user:app_secret@localhost:5432/enterprise_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Redis (optional cache)
REDIS_URL=redis://localhost:6379

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api

# JWT (short-lived access + rotating refresh tokens)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# AI assistant (optional — demo mode works without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Feature flags (advanced concepts)
FEATURE_AI_INSIGHTS=true
FEATURE_IDEMPOTENCY=true
FEATURE_CIRCUIT_BREAKER=true
FEATURE_DOMAIN_EVENTS=true
